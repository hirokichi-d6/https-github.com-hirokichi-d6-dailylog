NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Pooled connection for Prisma Client in Vercel / serverless.
DATABASE_URL=postgresql://postgres.your-ref:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct connection for Prisma Migrate / prisma migrate deploy.
DIRECT_URL=postgresql://postgres.your-ref:[YOUR-PASSWORD]@db.your-ref.supabase.co:5432/postgres

# Optional: when DATABASE_URL is not set, DailyLog uses file storage.
# On Vercel, the recommended path is /tmp for temporary demo persistence.
DAILYLOG_DATA_DIR=