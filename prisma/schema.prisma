generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Weather {
  SUNNY
  CLOUDY
  RAINY
  SNOWY
  OTHER
}

enum WindStrength {
  CALM
  LIGHT
  MODERATE
  STRONG
  VERY_STRONG
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  name         String?
  createdAt    DateTime     @default(now())
  settings     Json?
  entries      DailyEntry[]
  schedules    Schedule[]
  memos        Memo[]
}

model DailyEntry {
  id           String        @id @default(cuid())
  userId       String
  date         DateTime
  weather      Weather?
  temperature  Decimal?      @db.Decimal(4, 1)
  windStrength WindStrength?
  diaryContent String?
  tags         String[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  salesRecord  SalesRecord?
  memos        Memo[]
  attachments  Attachment[]

  @@unique([userId, date])
}

model SalesRecord {
  id            String          @id @default(cuid())
  entryId        String          @unique
  totalSales     Decimal?        @db.Decimal(12, 2)
  customerCount  Int?
  targetSales    Decimal?        @db.Decimal(12, 2)
  memo           String?
  createdAt      DateTime        @default(now())
  entry          DailyEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  categories     SalesCategory[]
}

model SalesCategory {
  id            String      @id @default(cuid())
  salesRecordId String
  categoryName  String
  amount        Decimal     @db.Decimal(12, 2)
  salesRecord   SalesRecord @relation(fields: [salesRecordId], references: [id], onDelete: Cascade)
}

model Schedule {
  id              String   @id @default(cuid())
  userId          String
  title           String
  startDatetime   DateTime
  endDatetime     DateTime?
  isAllDay        Boolean  @default(false)
  recurrenceRule  String?
  reminderMinutes Int[]
  category        String
  memo            String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Memo {
  id          String       @id @default(cuid())
  userId      String
  entryId     String?
  title       String
  content     String
  tags        String[]
  isPinned    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry       DailyEntry?  @relation(fields: [entryId], references: [id], onDelete: SetNull)
  attachments Attachment[]
}

model Attachment {
  id        String      @id @default(cuid())
  entryId   String?
  memoId    String?
  fileUrl   String
  fileType  String
  fileSize  Int
  createdAt DateTime    @default(now())
  entry     DailyEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  memo      Memo?       @relation(fields: [memoId], references: [id], onDelete: SetNull)
}
